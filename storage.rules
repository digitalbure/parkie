rules_version = '2';

// Phase 0 baseline: deny everything.
// Identity media (licences, selfies) will live in a separate locked bucket with CMEK,
// reachable only through short-lived signed URLs issued by Cloud Functions.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
