rules_version = '2';

// Phase 0 baseline: deny everything.
// Access is opened collection by collection, with emulator tests, as the data model lands.
// Principles (see CLAUDE.md): tenant isolation by operatorId, roles from custom claims,
// money/enforcement/identity writes only via Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
